root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Java files - Palantir Java Format style
[*.java]
indent_size = 4
max_line_length = 120

# Kotlin files
[*.{kt,kts}]
indent_size = 4

# Gradle files
[*.gradle]
indent_size = 4

[*.gradle.kts]
indent_size = 4

# YAML files (Spring config)
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Properties files
[*.properties]
indent_size = 2

# XML files
[*.xml]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
end_of_line = lf

# Windows batch files
[*.{bat,cmd}]
end_of_line = crlf

# Git config
[.gitattributes]
end_of_line = lf

[.gitignore]
end_of_line = lf

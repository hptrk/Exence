{
	"name": "exence",
	"version": "1.4.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "npm run test:unit && npm run test:integration && npm run test:e2e",
		"test:unit": "ng test --include='src/unit/**/*.spec.ts' --watch=false",
		"test:integration": "ng test --include='src/integration/**/*.spec.ts' --watch=false",
		"test:e2e": "npx playwright test",
		"test:e2e:headed": "npx playwright test --headed",
		"test:e2e:ui": "npx playwright test --ui",
		"format:check": "prettier . --check",
		"format:apply": "prettier . --write",
		"lint:check": "ng lint",
		"lint:apply": "ng lint --fix"
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "^21.0.1",
		"@angular/cdk": "^21.0.1",
		"@angular/common": "^21.0.1",
		"@angular/compiler": "^21.0.1",
		"@angular/core": "^21.0.1",
		"@angular/forms": "^21.0.1",
		"@angular/material": "^21.0.1",
		"@angular/material-date-fns-adapter": "^21.0.1",
		"@angular/platform-browser": "^21.0.1",
		"@angular/platform-browser-dynamic": "^21.0.1",
		"@angular/router": "^21.0.1",
		"@angular/service-worker": "^21.1.3",
		"@ngrx/signals": "^21.0.1",
		"angular-gridster2": "^21.0.1",
		"apexcharts": "^5.6.0",
		"bootstrap": "^5.3.7",
		"date-fns": "^4.1.0",
		"easymde": "^2.20.0",
		"echarts": "^6.0.0",
		"marked": "^18.0.0",
		"ngx-echarts": "^21.0.0",
		"ngx-infinite-scroll": "^21.0.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^21.0.1",
		"@angular/cli": "^21.0.1",
		"@angular/compiler-cli": "^21.0.1",
		"@eslint/js": "^9.39.2",
		"@jsverse/transloco": "^8.2.1",
		"@playwright/test": "^1.59.1",
		"@types/jasmine": "~5.1.0",
		"angular-eslint": "21.2.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^16.5.0",
		"jasmine-core": "~5.13.0",
		"karma": "~6.4.0",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.2.0",
		"karma-junit-reporter": "^2.0.1",
		"ng-apexcharts": "^2.0.4",
		"prettier": "^3.8.1",
		"sass": "^1.88.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.50.1"
	}
}
